---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Programmes"
  description="One weekly self defense class in Singapore. Four slots including a women's night and a family morning, plus private 1-on-1 and corporate training."
  activeNav="programmes"
  bodyLabel="04 Programmes">

<!-- PAGE HERO -->
<section class="trainers-hero">
  <div class="trainers-hero-bg">
    <img src="/assets/hero-programmes.jpg" alt="" />
  </div>
  <div class="wrap trainers-hero-overlay">
    <div class="crumb">
      <span>JF SELF DEFENSE</span><span class="sep">/</span><span class="here">PROGRAMMES</span>
    </div>
    <h1 class="display h1 trainers-hero-h1 programmes-hero-h1">
      <span class="prog-hero-l1">Same hierarchy.</span>
      <span class="prog-hero-l2">Rebuilt for <span class="red">your life</span>.</span>
    </h1>
  </div>
</section>

<!-- THE MAIN SELL: one weekly class, four slots -->
<section class="prog-lead" id="class">
  <div class="prog-lead-inner">

    <div class="prog-lead-pitch">
      <span class="eyebrow"><span class="dot"></span>THE WEEKLY CLASS</span>
      <h2 class="display prog-lead-title">Self Defense Class</h2>
      <p class="prog-lead-desc">
        One class, four mornings and evenings a week, at the studio on King George's
        Avenue. Fitness-led, scenario-led, drill-led. You build a working baseline of
        decisions and movement, and over months that baseline becomes the floor you
        can think from when something actually happens. Wednesday runs as a women's
        night and Sunday as a family session: same curriculum, same coach, same
        standard. Drop-in welcome, and you do not need to be fit to start.
      </p>
      <dl class="prog-lead-facts">
        <div>
          <dt>Format</dt>
          <dd>Weekly group class</dd>
        </div>
        <div>
          <dt>Duration</dt>
          <dd>60 min</dd>
        </div>
        <div>
          <dt>Level</dt>
          <dd>All levels, no experience needed</dd>
        </div>
        <div>
          <dt>Trial</dt>
          <dd class="prog-lead-price">Free, any slot</dd>
        </div>
      </dl>
    </div>

    <div class="prog-lead-schedule">
      <fieldset class="prog-slots">
        <legend class="prog-slots-legend">Four slots a week</legend>

        <label class="prog-slot">
          <input class="prog-slot-input" type="radio" name="class-slot" value="mon"
                 data-slot-input data-slot="Monday 7-8pm" />
          <span class="prog-slot-day">Mon</span>
          <span class="prog-slot-time">7-8pm</span>
          <span class="prog-slot-tag">All adults</span>
        </label>

        <label class="prog-slot">
          <input class="prog-slot-input" type="radio" name="class-slot" value="wed"
                 data-slot-input data-slot="Wednesday 7-8pm, women's night" />
          <span class="prog-slot-day">Wed</span>
          <span class="prog-slot-time">7-8pm</span>
          <span class="prog-slot-tag">Women's night</span>
        </label>

        <label class="prog-slot">
          <input class="prog-slot-input" type="radio" name="class-slot" value="sat"
                 data-slot-input data-slot="Saturday 9-10am" />
          <span class="prog-slot-day">Sat</span>
          <span class="prog-slot-time">9-10am</span>
          <span class="prog-slot-tag">All adults</span>
        </label>

        <label class="prog-slot">
          <input class="prog-slot-input" type="radio" name="class-slot" value="sun"
                 data-slot-input data-slot="Sunday 9.30-10.30am, family session" />
          <span class="prog-slot-day">Sun</span>
          <span class="prog-slot-time">9.30-10.30am</span>
          <span class="prog-slot-tag">Family</span>
        </label>
      </fieldset>

      <div class="prog-book">
        <p class="prog-book-note" data-slot-note aria-live="polite"
           data-slot-default="Pick the slot that fits your week, or leave it blank and Jeffrey will suggest one.">
          Pick the slot that fits your week, or leave it blank and Jeffrey will suggest one.
        </p>
        <a class="prog-page-cta prog-book-cta" href="#book"
           data-trial data-trial-programme="Self Defense Class" data-trial-when=""
           data-slot-cta>
          Book a free trial
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

  </div>
</section>

<!-- SECONDARY SILOS -->
<section class="section section-tight">
  <div class="wrap">
    <div class="section-head">
      <div><span class="section-head-num">ALSO AVAILABLE</span></div>
      <div>
        <h2 class="display h3 section-head-title">
          Two other ways<br/>to train with Jeffrey.
        </h2>
        <p class="lede" style="margin-top:20px;">
          Neither runs on the weekly schedule. Both are scoped and quoted per
          engagement, direct with Jeffrey.
        </p>
      </div>
    </div>

    <div class="prog-silos">

      <article class="prog-silo" id="personal">
        <h3 class="prog-silo-title">Personalised 1-on-1</h3>
        <p class="prog-silo-desc">
          Private sessions with Jeffrey, programmed against the specific risks of your
          routine, commute and travel. The honest option for students who want serious
          progress, or who would rather not train in front of others. Built one student
          at a time, so dates are arranged directly with him.
        </p>
        <div class="prog-silo-clients">
          <span class="prog-silo-clients-label">Best suited to</span>
          <p class="prog-silo-clients-list">
            Getting up to speed quickly, before a trip or a new posting ·
            A schedule that no fixed class time fits ·
            One specific concern: an incident, a fear, an injury ·
            Anyone who would rather not start in front of a group
          </p>
        </div>
        <dl class="prog-silo-meta">
          <div>
            <dt>Format</dt>
            <dd>1-on-1 with Jeffrey</dd>
          </div>
          <div>
            <dt>Duration</dt>
            <dd>60 to 90 min</dd>
          </div>
          <div>
            <dt>Rates &amp; times</dt>
            <dd>Message Jeffrey directly</dd>
          </div>
        </dl>
        <a class="prog-page-cta" href="https://wa.me/6596210576?text=Hi%20Jeffrey%2C%20I%27d%20like%20to%20enquire%20about%20Personalised%201-on-1%20training." target="_blank" rel="noopener">
          Message Jeffrey
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </article>

      <article class="prog-silo" id="corporate">
        <h3 class="prog-silo-title">Corporate &amp; Security Training</h3>
        <p class="prog-silo-desc">
          Half-day and full-day sessions delivered on-site for teams of 12 to 40. A
          practical wellbeing offer that actually makes a difference, and a memorable
          team day rather than another e-learning module.
        </p>
        <p class="prog-silo-desc" id="security">
          The same engagement track covers working officers, protective staff and
          in-house security teams, drawn from three decades on the other side of the
          badge. Curriculum scoped per engagement; references available on request.
        </p>
        <div class="prog-silo-clients">
          <span class="prog-silo-clients-label">Trained teams at</span>
          <p class="prog-silo-clients-list">
            SUSS · Celanese · Sloane Clinic · National Healthcare Group · Emerson ·
            Latham &amp; Watkins
          </p>
        </div>
        <dl class="prog-silo-meta">
          <div>
            <dt>Format</dt>
            <dd>On-site at your office</dd>
          </div>
          <div>
            <dt>Duration</dt>
            <dd>3 or 6 hours</dd>
          </div>
          <div>
            <dt>Scope &amp; cost</dt>
            <dd>Quoted per engagement</dd>
          </div>
        </dl>
        <a class="prog-page-cta" href="#book" data-trial data-trial-programme="Corporate &amp; security training">
          Request a proposal
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </article>

    </div>
  </div>
</section>

<!-- FAQ-ish belt -->
<section class="section-tight" style="border-top:1px solid var(--line);padding:64px 0;">
  <div class="wrap">
    <div class="faq-belt">
      <div>
        <div class="foot-h">First class?</div>
        <p class="body" style="font-size:15px;">
          Wear comfortable workout gear. We train barefoot or in clean indoor shoes.
          Bring water. No experience needed — most of our students started knowing
          nothing.
        </p>
      </div>
      <div>
        <div class="foot-h">Will I get hurt?</div>
        <p class="body" style="font-size:15px;">
          Classes are designed to be scalable and safe. We use protective equipment
          for any contact work, and Jeffrey programmes based on the body in front of
          him. Bruises happen. Injuries are rare.
        </p>
      </div>
      <div>
        <div class="foot-h">What if I can't make it weekly?</div>
        <p class="body" style="font-size:15px;">
          Packages are valid twelve months. Many of our working-parent students train
          every other week and still build real capability over a year. Show up when
          you can.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- CONTACT — inline form, page-bottom -->
<section class="contact-section" id="book">
  <div class="wrap">
    <div class="contact-inner">
      <div class="contact-pitch">
        <span class="eyebrow"><span class="dot"></span>BOOK A TRIAL</span>
        <h2>
          Pick a programme.<br/>Send a short note.<br/>
          <span class="red">We'll do the rest.</span>
        </h2>
        <p class="body" style="font-size:16px;max-width:42ch;">
          Trial sessions for the weekly Self Defense Class are free, any of the four
          slots. Personalised 1-on-1, corporate workshops and security training are
          quoted per engagement.
        </p>
        <div class="contact-side">
          <div class="contact-side-row">
            <span class="label">STUDIO</span>
            <span class="val">342D King George's Ave<br/>Singapore 208575</span>
          </div>
          <div class="contact-side-row">
            <span class="label">CLASS TIMES</span>
            <span class="val">Mon &amp; Wed · 7-8pm<br/>Sat · 9-10am<br/>Sun · 9.30-10.30am</span>
          </div>
          <div class="contact-side-row">
            <span class="label">EMAIL</span>
            <span class="val"><a href="mailto:Jeffrey.f@jfselfdefense.com">Jeffrey.f@jfselfdefense.com</a></span>
          </div>
          <div class="contact-side-row">
            <span class="label">WHATSAPP</span>
            <span class="val"><a href="https://wa.me/6596210576" target="_blank" rel="noopener">+65 9621 0576</a></span>
          </div>
        </div>
      </div>
      <div data-inline-trial-form></div>
    </div>
  </div>
</section>

<!-- FOOTER -->

</BaseLayout>
